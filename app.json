{
  "expo": {
    "name": "家庭网盘",
    "slug": "filebrowser-app",
    "version": "1.9.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "filebrowserapp",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "dev.sprytnyk.filebrowser",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#141D24",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "versionCode": 13
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f5f5f5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#141D24",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 26
          },
          "ios": {
            "deploymentTarget": "16.0",
            "usePrecompiledModules": false
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "android": [
              "en",
              "uk"
            ]
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to pick photos and videos to upload.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-asset",
      "@lunarr/mpv-player"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aad2e891-4533-43f2-b687-101953ed67e6"
      }
    },
    "owner": "sprytnyks-team",
    "ios": {
      "bundleIdentifier": "dev.sprytnyk.filebrowser",
      "buildNumber": "13",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "用于访问家里的家庭网盘服务器",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    }
  }
}
